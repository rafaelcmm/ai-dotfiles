# Google API environment contract.
#
# Copy the keys you need into the project's gitignored .env. Nothing here is a
# value — every line is a name plus how to obtain it.
#
# Claude Code does not read .env. Bridge it into the launching shell with direnv
# (`echo dotenv > .envrc && direnv allow`) or `set -a && source .env && set +a`.

# --- Shared across every Google API ----------------------------------------

# Absolute path to the Application Default Credentials file written by
# `gcloud auth application-default login`. Default location is
# ~/.config/gcloud/application_default_credentials.json, but set it explicitly:
# tools that read ADC through a client library find the default path on their
# own, and tools that read the variable directly do not.
GOOGLE_APPLICATION_CREDENTIALS=

# Cloud project the API usage is billed and quota-counted against. Must have the
# relevant APIs enabled. Search Console and Merchant fail with SERVICE_DISABLED
# without a quota project; Google Ads does not need one.
GOOGLE_PROJECT_ID=

# Path to the Desktop OAuth client JSON downloaded from the Cloud Console.
# Read by scripts/google-adc-login.sh. gcloud's built-in client cannot request
# the adwords scope, so a Desktop client is mandatory, not a preference.
GOOGLE_OAUTH_CLIENT_FILE=

# --- Google Ads -------------------------------------------------------------

# Developer token from a Manager (MCC) account: Tools -> API Center. A token in
# "test account" access level works only against test accounts and returns
# otherwise-inscrutable errors on a production account.
GOOGLE_ADS_DEVELOPER_TOKEN=

# Manager (MCC) account id, 10 digits, no hyphens. Required only when the target
# account sits under a manager. Leave UNSET rather than empty when there is no
# manager — sending a blank login-customer-id header is itself an error.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Target advertising account id, 10 digits, no hyphens. Usually passed per
# invocation rather than stored, so that one checkout cannot silently write to
# the wrong account.
GOOGLE_ADS_CUSTOMER_ID=

# Pin the API version. Google sunsets versions on a rolling ~1-year cadence and
# a sunset version returns an HTML 404 rather than degrading. Unset means the
# client's own pinned default.
GOOGLE_ADS_API_VERSION=

# --- Google Analytics 4 -----------------------------------------------------

# Numeric GA4 property id (not the G-XXXX measurement id).
GA4_PROPERTY_ID=

# Measurement Protocol credentials, needed only for server-side events.
# The API secret is created per data stream in the GA4 admin UI.
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# --- Search Console ---------------------------------------------------------

# Property as Search Console identifies it, which is NOT always a bare URL:
# a domain property is `sc-domain:example.com`, a URL-prefix property is the
# full origin with trailing slash, e.g. `https://www.example.com/`.
SEARCH_CONSOLE_SITE_URL=

# --- Merchant Center --------------------------------------------------------

# Merchant Center account id. Use the sub-account id when operating under an
# advanced (multi-client) account, not the parent's.
MERCHANT_CENTER_ACCOUNT_ID=
